# Optional: if omitted, first launch generates strong local credentials and writes .env.
# Keep this file private. Do not commit .env.
MOSAIC_ADMIN_PASSWORD=
MOSAIC_LOCAL_API_KEY=
MOSAIC_HOST=127.0.0.1
MOSAIC_PORT=8000

# Optional location for local database and encryption key
# MOSAIC_DATA_DIR=./data

# Auto-refresh discovered provider model catalogs every 30 minutes. Set to 0 to disable.
MOSAIC_DISCOVERY_INTERVAL_SECONDS=1800

# Maximum pages to follow from same-origin provider model catalogs (1–100).
MOSAIC_DISCOVERY_MAX_PAGES=10

# Sticky conversation routing lifetime. Set 0 to disable.
MOSAIC_STICKY_SESSION_TTL_SECONDS=1800
